@using Microsoft.AspNetCore.Components.Authorization

<!--
===========================================================
ChefConnect - Navigation Bar

Purpose:
Provides the main navigation links for ChefConnect.

Authenticated users can:
    • View recipes
    • Access their profile
    • Log out

Unauthenticated users can:
    • Register
    • Log in

Bootstrap Icons are used to keep the navigation simple
and consistent with the rest of the application.
===========================================================
-->

<nav class="navbar"
     role="navigation"
     aria-label="Main Navigation">

    <AuthorizeView>

        <!--
        ===================================================
        Authenticated User Navigation
        ===================================================
        -->
        <Authorized>

            <!-- Recipes -->
            <NavLink href="recipes"
                     class="navbar-item"
                     Match="NavLinkMatch.Prefix">

                <i class="bi bi-journal-text me-1"
                   aria-hidden="true"></i>

                Recipes

            </NavLink>

            <!-- User Profile -->
            <NavLink href="profile"
                     class="navbar-item">

                <i class="bi bi-person me-1"
                   aria-hidden="true"></i>

                @(context.User.Identity?.Name?.Split('@')[0])'s Profile

            </NavLink>

            <!--
            Logout is submitted using POST rather than GET.
            This allows ASP.NET Core Identity to safely clear
            the authentication cookie.
            -->
            <form action="Account/Logout"
                  method="post"
                  class="d-inline">

                <AntiforgeryToken />

                <!--
                Return the user to the home page after logout.
                -->
                <input type="hidden"
                       name="returnUrl"
                       value="/" />

                <button type="submit"
                        class="navbar-item btn btn-link text-decoration-none">

                    <i class="bi bi-box-arrow-right me-1"
                       aria-hidden="true"></i>

                    Logout

                </button>

            </form>

        </Authorized>

        <!--
        ===================================================
        Guest Navigation
        ===================================================
        -->
        <NotAuthorized>

            <!-- Register -->
            <NavLink href="Account/Register"
                     class="navbar-item">

                <i class="bi bi-person-plus me-1"
                   aria-hidden="true"></i>

                Register

            </NavLink>

            <!-- Login -->
            <NavLink href="Account/Login"
                     class="navbar-item">

                <i class="bi bi-box-arrow-in-right me-1"
                   aria-hidden="true"></i>

                Login

            </NavLink>

        </NotAuthorized>

    </AuthorizeView>

</nav>