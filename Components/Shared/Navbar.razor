@using Microsoft.AspNetCore.Components.Authorization

<!--
===========================================================
ChefConnect - Navigation Bar

Purpose:
Provides the main navigation links for ChefConnect.

Layout:
    Home · Recipes · [Add Recipe] · [account menu]

Authenticated users can:
    • Browse recipes
    • Start a new recipe
    • Open their profile or log out from the account menu

Unauthenticated users can:
    • Log in
    • Register

The menus are built from a checkbox and a details element so
the header keeps working without any scripting, and so the
logout form is still submitted by the server.
===========================================================
-->

<nav class="navbar"
     role="navigation"
     aria-label="Main Navigation">

    <!--
    Small screens collapse the links behind this control.
    It is hidden on wider screens, where the links are always
    displayed.
    -->
    <input type="checkbox"
           id="nav-menu-toggle"
           class="nav-menu-toggle" />

    <label for="nav-menu-toggle"
           class="nav-menu-button"
           aria-label="Show or hide the navigation menu">

        <i class="bi bi-list" aria-hidden="true"></i>

    </label>

    <div class="nav-items">

        <!-- Home -->
        <NavLink href=""
                 class="navbar-item"
                 Match="NavLinkMatch.All">

            Home

        </NavLink>

        <!-- Recipes -->
        <NavLink href="recipes"
                 class="navbar-item"
                 Match="NavLinkMatch.Prefix">

            Recipes

        </NavLink>

        <AuthorizeView>

            <!--
            ===================================================
            Authenticated User Navigation
            ===================================================
            -->
            <Authorized>

                <!-- The main action of the application -->
                <a href="/recipes/create"
                   class="nav-cta">

                    <i class="bi bi-plus-lg me-1"
                       aria-hidden="true"></i>

                    Add Recipe

                </a>

                <!-- Account menu -->
                <details class="account-menu">

                    <summary class="account-trigger"
                             aria-label="Account menu">

                        <span class="account-avatar"
                              aria-hidden="true">

                            @GetInitial(context.User.Identity?.Name)

                        </span>

                        <i class="bi bi-chevron-down account-caret"
                           aria-hidden="true"></i>

                    </summary>

                    <div class="account-panel">

                        <p class="account-signed-in">
                            Signed in as
                            <strong>@context.User.Identity?.Name</strong>
                        </p>

                        <NavLink href="profile"
                                 class="account-link">

                            <i class="bi bi-person"
                               aria-hidden="true"></i>

                            My Profile

                        </NavLink>

                        <!--
                        Logout is submitted using POST rather than GET.
                        This allows ASP.NET Core Identity to safely clear
                        the authentication cookie.
                        -->
                        <form action="Account/Logout"
                              method="post">

                            <AntiforgeryToken />

                            <!--
                            Return the user to the home page after logout.
                            -->
                            <input type="hidden"
                                   name="returnUrl"
                                   value="/" />

                            <button type="submit"
                                    class="account-link account-logout">

                                <i class="bi bi-box-arrow-right"
                                   aria-hidden="true"></i>

                                Log out

                            </button>

                        </form>

                    </div>

                </details>

            </Authorized>

            <!--
            ===================================================
            Guest Navigation
            ===================================================
            -->
            <NotAuthorized>

                <NavLink href="Account/Login"
                         class="navbar-item">

                    Login

                </NavLink>

                <!-- Registering is the action new visitors need -->
                <a href="Account/Register"
                   class="nav-cta">

                    Register

                </a>

            </NotAuthorized>

        </AuthorizeView>

    </div>

</nav>

@code
{
    /// <summary>
    /// First letter of the signed-in user's account name, shown in
    /// the small circle that opens the account menu.
    /// </summary>
    private static string GetInitial(string? accountName)
    {
        return string.IsNullOrWhiteSpace(accountName)
            ? "?"
            : accountName.Trim()[..1].ToUpperInvariant();
    }

}
