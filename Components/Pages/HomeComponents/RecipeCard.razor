@using System.Security.Claims
@using ChefConnect.Services
@inject RecipeService RecipeService
@inject AuthenticationStateProvider AuthStateProvider

<NavLink class="recipe-card-link" href="@($"/recipes/{Recipe.Id}")">
    <article class="recipe-card">
        @* Works for both external image URLs and uploaded images *@
        @if (!string.IsNullOrWhiteSpace(imageSource))
        {
            <img class="recipe-image" src="@imageSource" alt="@Recipe.Name" loading="lazy" />
        }
        else{
            <div class="recipe-image-placeholder">No photo</div>
        }
        <div class="recipe-card-content">
            <h3 class="recipe-title">@Recipe.Name</h3>
            <p class="recipe-servings">Servings: @Recipe.Servings</p>
            <p class="recipe-time"><span class="watch-emoji">⏱</span> @time minutes</p>
            @if (ShowFavoriteButton)
            {
                @* preventDefault keeps the surrounding card link from
                   opening the recipe when the heart is clicked *@
                <button type="button" class="favorite-btn @(IsFavorite ? "is-favorite" : "")" title="@(IsFavorite ? "Remove from favorites" : "Add to favorites")" @onclick="HandleToggle" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                    @(IsFavorite ? "♥" : "♡")
                </button>
            }
        </div>
    </article>
</NavLink>

@code {
    [Parameter]
    public Recipe Recipe {get; set;} = default!;

    // Whether the current viewer is logged in
    //  parent already knows this, fetched once
    //  per page load rather than once per card
    [Parameter]
    public bool ShowFavoriteButton { get; set; }

    // Whether recipe is already favorited by the user
    [Parameter]
    public bool IsFavorite { get; set; }

    // Parent owns the actual DB call
    //  the card just reports which recipe was clicked
    [Parameter]
    public EventCallback<Recipe> OnToggleFavorite { get; set; }

    private int time;

    // Image source resolved from the stored recipe image value
    //  this is either an external URL or an uploaded image path
    private string? imageSource;

    protected override void OnParametersSet()
    {
        time = Recipe.PreparationTime + Recipe.CookingTime;
        imageSource = RecipeImageService.ResolveImageSource(Recipe.ImageUrl);
    }

    private async Task HandleToggle()
    {
        if (OnToggleFavorite.HasDelegate)
        {
            await OnToggleFavorite.InvokeAsync(Recipe);
        }
    }
}
