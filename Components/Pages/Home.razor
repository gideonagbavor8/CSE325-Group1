@if (recipes is null)
{
	<p><em>Loading recipes...</em></p>
}
else if (!FilteredRecipes.Any())
{
	<p class="text-muted">No recipes match your search.</p>
}
else
{
	<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
		@foreach (var recipe in FilteredRecipes)
		{
			<div class="col">
				<RecipeCard Recipe="@recipe"
							ShowFavoriteButton="@isAuthenticated"
							IsFavorite="@favoriteIds.Contains(recipe.Id)"
							OnToggleFavorite="ToggleFavorite" />
			</div>
		}
	</div>
}

@code {
	private List<Recipe>? recipes;
	private List<Category> categories = new();
	private string searchText = string.Empty;
	private string selectedCategoryId = string.Empty;

	// Favorites are kept separate from the recipe list so that
	// favoriting a recipe never changes what the search returns.
	private bool isAuthenticated;
	private string? userId;
	private HashSet<int> favoriteIds = new();

	private bool ShouldShowMealCard(string mealName) =>
		string.IsNullOrWhiteSpace(searchText) ||
		mealName.Contains(searchText, StringComparison.OrdinalIgnoreCase);

	private void SelectMealCategory(string categoryName)
	{
		var category = categories.FirstOrDefault(item =>
			item.Name.Equals(categoryName, StringComparison.OrdinalIgnoreCase));

		selectedCategoryId = category?.Id.ToString() ?? string.Empty;
	}

	private IEnumerable<Recipe> FilteredRecipes =>
		recipes?.Where(recipe =>
			(string.IsNullOrWhiteSpace(searchText) ||
			 recipe.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
			 recipe.Category?.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) &&
			(string.IsNullOrEmpty(selectedCategoryId) ||
			 recipe.CategoryId.ToString() == selectedCategoryId))
		?? Enumerable.Empty<Recipe>();

	protected override async Task OnInitializedAsync()
	{
		categories = await DbContext.Categories
			.AsNoTracking()
			.OrderBy(category => category.Name)
			.ToListAsync();

		recipes = await DbContext.Recipes
			.AsNoTracking()
			.Include(recipe => recipe.Category)
			.OrderBy(recipe => recipe.Name)
			.ToListAsync();

		// Load which of those recipes the current user has favorited.
		// This only decides how the heart is drawn. The recipe list
		// itself is never filtered by favorites.
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		isAuthenticated = user.Identity?.IsAuthenticated ?? false;

		if (isAuthenticated)
		{
			userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

			if (!string.IsNullOrWhiteSpace(userId))
			{
				favoriteIds = await RecipeService.GetFavoriteRecipeIdsAsync(userId);
			}
		}
	}

	/// <summary>
	/// Adds or removes a recipe from the current user's favorites.
	///
	/// Only the favorite list is updated. The recipes shown on the
	/// page and the current search are left untouched, so a recipe
	/// stays in the results after it is favorited.
	/// </summary>
	private async Task ToggleFavorite(Recipe recipe)
	{
		if (string.IsNullOrWhiteSpace(userId))
		{
			return;
		}

		var isNowFavorite = await RecipeService.ToggleFavoriteAsync(userId, recipe.Id);

		if (isNowFavorite)
		{
			favoriteIds.Add(recipe.Id);
		}
		else
		{
			favoriteIds.Remove(recipe.Id);
		}
	}
}

