@page "/"
@rendermode InteractiveServer
@using System.Security.Claims
@using ChefConnect.Components.Pages.HomeComponents
@using ChefConnect.Data
@using ChefConnect.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject RecipeService RecipeService
@inject AuthenticationStateProvider AuthStateProvider

<h1>Find a recipe</h1>

<div class="search-section">
	<div class="row g-3 mb-4" role="search">
		<div class="col-md-8">
			<label for="recipe-search" class="form-label">Search by recipe name</label>
			<input id="recipe-search" class="form-control search-bar" type="search" placeholder="Try ''pancakes'' or ''rice''..."
				@bind="searchText" @bind:event="oninput" />
		</div>
		<div class="col-md-4">
			<label for="category-filter" class="form-label">Category</label>
			<select id="category-filter" class="form-select" @bind="selectedCategoryId">
				<option value="">All categories</option>
				@foreach (var category in categories)
				{
					<option value="@category.Id">@category.Name</option>
				}
			</select>
		</div>
	</div>
</div>

