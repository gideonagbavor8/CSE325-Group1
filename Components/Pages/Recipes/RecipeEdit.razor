@page "/recipes/edit/{Id:int}"
@rendermode InteractiveServer
@using System.Security.Claims
@inject RecipeService RecipeService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<h3>Edit Recipe</h3>

@if (recipe == null)
{
    <p>Loading...</p>
}
else if (!isOwner)
{
    <p>You are not authorized to edit this recipe.</p>
}
else
{
    <EditForm Model="recipe" OnValidSubmit="HandleSubmit" FormName="EditRecipeForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="recipe.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="recipe.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Category</label>
            <InputSelect class="form-control" @bind-Value="recipe.CategoryId">
                <option value="0">Select Category...</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Ingredients</label>
            <InputTextArea class="form-control" @bind-Value="recipe.Ingredients" />
        </div>

        <div class="mb-3">
            <label class="form-label">Instructions</label>
            <InputTextArea class="form-control" @bind-Value="recipe.Instructions" />
        </div>

        <div class="mb-3">
            <label class="form-label">Preparation Time (mins)</label>
            <InputNumber class="form-control" @bind-Value="recipe.PreparationTime" />
        </div>

        <div class="mb-3">
            <label class="form-label">Cooking Time (mins)</label>
            <InputNumber class="form-control" @bind-Value="recipe.CookingTime" />
        </div>

        <div class="mb-3">
            <label class="form-label">Servings</label>
            <InputNumber class="form-control" @bind-Value="recipe.Servings" />
        </div>

        <div class="mb-3">
            <label class="form-label">Image URL</label>
            <InputText class="form-control" @bind-Value="recipe.ImageUrl" />
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
        <a href="/recipes" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    private Recipe? recipe { get; set; }
    private List<Category> categories = new();
    private bool isOwner;

    protected override async Task OnInitializedAsync()
    {
        if (recipe == null)
        {
            recipe = await RecipeService.GetRecipeByIdAsync(Id);
        }
        categories = await RecipeService.GetCategoriesAsync();

        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            string? userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (recipe != null && recipe.UserId == userId)
            {
                isOwner = true;
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (recipe != null && isOwner)
        {
            await RecipeService.UpdateRecipeAsync(recipe);
            NavigationManager.NavigateTo("/recipes", forceLoad: true);
        }
    }
}