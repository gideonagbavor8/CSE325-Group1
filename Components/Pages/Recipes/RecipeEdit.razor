@page "/recipes/edit/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ChefConnect.Models
@using ChefConnect.Services

@inject RecipeService RecipeService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment

<!--
===========================================================
ChefConnect - Edit Recipe

Purpose:
Allows the owner of a recipe to update its information.

Security:
Only the authenticated user who created the recipe is
allowed to edit it. The ownership check is performed using
the ASP.NET Core Identity user ID.

The form includes validation based on the Recipe model's
Data Annotations.
===========================================================
-->

<PageTitle>Edit Recipe | ChefConnect</PageTitle>

<div class="container py-4">

    @if (recipe == null)
    {
        <!-- Displayed while the recipe is being retrieved. -->
        <div class="text-center py-5">

            <div class="spinner-border"
                 role="status"
                 aria-label="Loading recipe">
            </div>

            <p class="mt-2">
                Loading recipe...
            </p>

        </div>
    }
    else if (!isOwner)
    {
        <!--
        The recipe exists, but the authenticated user does
        not own it.
        -->

        <div class="alert alert-danger"
             role="alert">

            <h1 class="h4">
                Access Denied
            </h1>

            <p>
                You are not authorized to edit this recipe.
            </p>

            <a href="/recipes"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"
                   aria-hidden="true"></i>

                Back to Recipes

            </a>

        </div>
    }
    else
    {
        <!-- Page heading -->
        <div class="mb-4">

            <h1>
                Edit Recipe
            </h1>

            <p class="text-muted">
                Update the information for
                <strong>@recipe.Name</strong>.
            </p>

        </div>

        <EditForm Model="recipe"
                  OnValidSubmit="HandleSubmit"
                  FormName="EditRecipeForm">

            <!-- Enable Data Annotations validation -->
            <DataAnnotationsValidator />

            <!-- Display validation errors -->
            <ValidationSummary class="text-danger" />

            <!-- Recipe Name -->
            <div class="mb-3">

                <label for="recipe-name"
                       class="form-label">
                    Name
                </label>

                <InputText id="recipe-name"
                           class="form-control"
                           @bind-Value="recipe.Name" />

                <ValidationMessage For="() => recipe.Name"
                                   class="text-danger" />

            </div>

            <!-- Description -->
            <div class="mb-3">

                <label for="recipe-description"
                       class="form-label">
                    Description
                </label>

                <InputTextArea id="recipe-description"
                               class="form-control"
                               rows="3"
                               @bind-Value="recipe.Description" />

                <ValidationMessage For="() => recipe.Description"
                                   class="text-danger" />

            </div>

            <!-- Category -->
            <div class="mb-3">

                <label for="recipe-category"
                       class="form-label">
                    Category
                </label>

                <InputSelect id="recipe-category"
                             class="form-select"
                             @bind-Value="recipe.CategoryId">

                    <option value="0">
                        Select Category...
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </InputSelect>

                <ValidationMessage For="() => recipe.CategoryId"
                                   class="text-danger" />

            </div>

            <!-- Ingredients -->
            <div class="mb-3">

                <label for="recipe-ingredients"
                       class="form-label">
                    Ingredients
                </label>

                <InputTextArea id="recipe-ingredients"
                               class="form-control"
                               rows="5"
                               placeholder="Enter the ingredients."
                               @bind-Value="recipe.Ingredients" />

                <ValidationMessage For="() => recipe.Ingredients"
                                   class="text-danger" />

            </div>

            <!-- Instructions -->
            <div class="mb-3">

                <label for="recipe-instructions"
                       class="form-label">
                    Instructions
                </label>

                <InputTextArea id="recipe-instructions"
                               class="form-control"
                               rows="6"
                               placeholder="Enter the cooking instructions."
                               @bind-Value="recipe.Instructions" />

                <ValidationMessage For="() => recipe.Instructions"
                                   class="text-danger" />

            </div>

            <!-- Preparation Time -->
            <div class="mb-3">

                <label for="recipe-preparation"
                       class="form-label">
                    Preparation Time (mins)
                </label>

                <InputNumber id="recipe-preparation"
                             class="form-control"
                             @bind-Value="recipe.PreparationTime" />

                <ValidationMessage For="() => recipe.PreparationTime"
                                   class="text-danger" />

            </div>

            <!-- Cooking Time -->
            <div class="mb-3">

                <label for="recipe-cooking"
                       class="form-label">
                    Cooking Time (mins)
                </label>

                <InputNumber id="recipe-cooking"
                             class="form-control"
                             @bind-Value="recipe.CookingTime" />

                <ValidationMessage For="() => recipe.CookingTime"
                                   class="text-danger" />

            </div>

            <!-- Servings -->
            <div class="mb-3">

                <label for="recipe-servings"
                       class="form-label">
                    Servings
                </label>

                <InputNumber id="recipe-servings"
                             class="form-control"
                             @bind-Value="recipe.Servings" />

                <ValidationMessage For="() => recipe.Servings"
                                   class="text-danger" />

            </div>

            <!--
            Recipe image.
            The user may upload a replacement file or supply an
            image URL. Leaving both empty keeps the current image.
            -->
            <RecipeImageInput @bind-ImageUrl="imageUrl"
                              @bind-SelectedFile="selectedImage"
                              @bind-ErrorMessage="imageErrorMessage"
                              CurrentImageUrl="@existingImageUrl" />

            <!-- Form actions -->
            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save me-1"
                       aria-hidden="true"></i>

                    Update Recipe

                </button>

                <a href="/recipes"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </div>

        </EditForm>
    }

</div>

@code
{
    /// <summary>
    /// Recipe ID supplied through the URL.
    /// </summary>
    [Parameter]
    public int Id { get; set; }

    /// <summary>
    /// Recipe currently being edited.
    /// </summary>
    [SupplyParameterFromForm]
    private Recipe? recipe { get; set; }

    // Available recipe categories.
    private List<Category> categories = new();

    // Determines whether the authenticated user owns the recipe.
    private bool isOwner;

    // Externally hosted image URL entered by the user.
    private string? imageUrl;

    // Image selected from the user's computer, if any.
    private IBrowserFile? selectedImage;

    // Validation message for the recipe image.
    private string? imageErrorMessage;

    // Image already saved on the recipe.
    private string? existingImageUrl;

    /// <summary>
    /// Loads the recipe, categories, and ownership information.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Retrieve the recipe selected by the URL ID.
        recipe = await RecipeService.GetRecipeByIdAsync(Id);

        // Remember the saved image so it can be kept when the user
        // does not choose a new one.
        existingImageUrl = recipe?.ImageUrl;

        // Uploaded images are stored as a local path, so only an
        // external URL is placed back into the Image URL field.
        imageUrl = RecipeImageService.IsUploadedImagePath(existingImageUrl)
            ? null
            : existingImageUrl;

        // Retrieve available categories.
        categories = await RecipeService.GetCategoriesAsync();

        // Retrieve the current authentication state.
        AuthenticationState authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        ClaimsPrincipal user = authState.User;

        // Check whether the current user is authenticated.
        if (!(user.Identity?.IsAuthenticated ?? false))
        {
            return;
        }

        // Retrieve the current user's Identity ID.
        string? userId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        // Confirm that the recipe belongs to the current user.
        if (recipe != null &&
            !string.IsNullOrWhiteSpace(userId) &&
            recipe.UserId == userId)
        {
            isOwner = true;
        }
    }

    /// <summary>
    /// Saves the updated recipe after validation and ownership
    /// verification.
    /// </summary>
    private async Task HandleSubmit()
    {
        // Never update a missing recipe or a recipe
        // belonging to another user.
        if (recipe == null || !isOwner)
        {
            return;
        }

        // Apply the image before saving so an invalid image stops
        // the update.
        if (!await ApplyRecipeImageAsync())
        {
            return;
        }

        // Save the updated recipe.
        await RecipeService.UpdateRecipeAsync(recipe);

        // Return to the recipe list after a successful update.
        NavigationManager.NavigateTo("/recipes");
    }

    /// <summary>
    /// Applies the chosen recipe image.
    ///
    /// An uploaded image takes priority over the image URL. When
    /// neither is supplied the recipe keeps the image it already
    /// had, unless the user cleared an existing image URL.
    /// </summary>
    /// <returns>
    /// True when the image is valid and the recipe can be saved.
    /// </returns>
    private async Task<bool> ApplyRecipeImageAsync()
    {
        if (recipe == null)
        {
            return false;
        }

        imageErrorMessage = null;

        // An uploaded image always wins over the image URL.
        if (selectedImage is not null)
        {
            var fileMessage =
                RecipeImageService.GetFileValidationMessage(selectedImage);

            if (fileMessage is not null)
            {
                imageErrorMessage = fileMessage;

                return false;
            }

            try
            {
                recipe.ImageUrl =
                    await RecipeImageService.SaveUploadedImageAsync(
                        Environment,
                        selectedImage);

                return true;
            }
            catch (Exception)
            {
                imageErrorMessage =
                    "The image could not be uploaded. Please try again.";

                return false;
            }
        }

        // Otherwise use the image URL when one was entered.
        if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            if (!RecipeImageService.IsValidExternalImageUrl(imageUrl))
            {
                imageErrorMessage =
                    "Enter a valid image URL that starts with http:// or https://.";

                return false;
            }

            recipe.ImageUrl = imageUrl.Trim();

            return true;
        }

        // Nothing was supplied. An uploaded image is kept, while a
        // cleared image URL removes the image.
        recipe.ImageUrl =
            RecipeImageService.IsUploadedImagePath(existingImageUrl)
                ? existingImageUrl
                : null;

        return true;
    }
}