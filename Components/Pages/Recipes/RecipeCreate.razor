@page "/recipes/create"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ChefConnect.Models
@using ChefConnect.Services

@inject RecipeService RecipeService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment

<!--
===========================================================
ChefConnect - Create Recipe

Purpose:
Allows authenticated users to create a new recipe.

The form collects the recipe name, description, category,
ingredients, instructions, preparation time, cooking time,
servings, and optional image URL.

The authenticated user's Identity ID is assigned to the
recipe before it is saved.
===========================================================
-->

<PageTitle>Create Recipe | ChefConnect</PageTitle>

<div class="container py-4 form-page">

    <div class="page-intro">
        <h1>Create Recipe</h1>

        <p>
            Add a new recipe to ChefConnect.
        </p>
    </div>

    <div class="form-card">

    <EditForm Model="recipe"
              OnValidSubmit="HandleSubmit"
              FormName="CreateRecipeForm">

        <!-- Enable Data Annotations validation -->
        <DataAnnotationsValidator />

        <!-- Display validation errors -->
        <ValidationSummary class="text-danger" />

        <!-- Name and category share a row on wider screens -->
        <div class="row g-3 mb-3">

            <div class="col-md-7">

                <label for="recipe-name"
                       class="form-label">
                    Name
                </label>

                <InputText id="recipe-name"
                           class="form-control"
                           @bind-Value="recipe.Name" />

                <ValidationMessage For="() => recipe.Name"
                                   class="text-danger" />

            </div>

            <div class="col-md-5">

                <label for="recipe-category"
                       class="form-label">
                    Category
                </label>

                <InputSelect id="recipe-category"
                             class="form-select"
                             @bind-Value="recipe.CategoryId">

                    <option value="0">
                        Select Category...
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </InputSelect>

                <ValidationMessage For="() => recipe.CategoryId"
                                   class="text-danger" />

            </div>

        </div>

        <!-- Description -->
        <div class="mb-3">

            <label for="recipe-description"
                   class="form-label">
                Description
            </label>

            <InputTextArea id="recipe-description"
                           class="form-control"
                           rows="2"
                           @bind-Value="recipe.Description" />

            <ValidationMessage For="() => recipe.Description"
                               class="text-danger" />

        </div>

        <!-- Ingredients -->
        <div class="mb-3">

            <label for="recipe-ingredients"
                   class="form-label">
                Ingredients
            </label>

            <InputTextArea id="recipe-ingredients"
                           class="form-control"
                           rows="4"
                           placeholder="Enter ingredients separated by commas or lines."
                           @bind-Value="recipe.Ingredients" />

            <ValidationMessage For="() => recipe.Ingredients"
                               class="text-danger" />

        </div>

        <!-- Instructions -->
        <div class="mb-3">

            <label for="recipe-instructions"
                   class="form-label">
                Instructions
            </label>

            <InputTextArea id="recipe-instructions"
                           class="form-control"
                           rows="5"
                           placeholder="Enter the cooking instructions."
                           @bind-Value="recipe.Instructions" />

            <ValidationMessage For="() => recipe.Instructions"
                               class="text-danger" />

        </div>

        <!-- Times and servings sit together to keep the form short -->
        <div class="row g-3 mb-3">

            <div class="col-sm-4">

                <label for="recipe-preparation"
                       class="form-label">
                    Prep (mins)
                </label>

                <InputNumber id="recipe-preparation"
                             class="form-control"
                             @bind-Value="recipe.PreparationTime" />

                <ValidationMessage For="() => recipe.PreparationTime"
                                   class="text-danger" />

            </div>

            <div class="col-sm-4">

                <label for="recipe-cooking"
                       class="form-label">
                    Cooking (mins)
                </label>

                <InputNumber id="recipe-cooking"
                             class="form-control"
                             @bind-Value="recipe.CookingTime" />

                <ValidationMessage For="() => recipe.CookingTime"
                                   class="text-danger" />

            </div>

            <div class="col-sm-4">

                <label for="recipe-servings"
                       class="form-label">
                    Servings
                </label>

                <InputNumber id="recipe-servings"
                             class="form-control"
                             @bind-Value="recipe.Servings" />

                <ValidationMessage For="() => recipe.Servings"
                                   class="text-danger" />

            </div>

        </div>

        <!--
        Recipe image.
        The user may upload a file or supply an image URL.
        -->
        <RecipeImageInput @bind-ImageUrl="imageUrl"
                          @bind-SelectedFile="selectedImage"
                          @bind-ErrorMessage="imageErrorMessage" />

        <!-- Form buttons -->
        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"
                   aria-hidden="true"></i>

                Save Recipe

            </button>

            <a href="/recipes"
               class="btn btn-secondary">

                Cancel

            </a>

        </div>

    </EditForm>

    </div>

</div>

@code
{
    // Stores the recipe being created.
    [SupplyParameterFromForm]
    private Recipe recipe { get; set; } = new();

    // Stores the available recipe categories.
    private List<Category> categories = new();

    // Externally hosted image URL entered by the user.
    private string? imageUrl;

    // Image selected from the user's computer, if any.
    private IBrowserFile? selectedImage;

    // Validation message for the recipe image.
    private string? imageErrorMessage;

    /// <summary>
    /// Loads the available recipe categories when the page opens.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        categories = await RecipeService.GetCategoriesAsync();
    }

    /// <summary>
    /// Handles the recipe creation form submission.
    /// </summary>
    private async Task HandleSubmit()
    {
        // Apply the image before anything is saved so an invalid
        // image stops the recipe from being created.
        if (!await ApplyRecipeImageAsync())
        {
            return;
        }

        // Retrieve the current authentication state.
        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        // Get the authenticated user's Identity ID.
        var userId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        // Make sure a logged-in user is associated with the recipe.
        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        // Assign the current user as the recipe owner.
        recipe.UserId = userId;

        // Save the recipe to the database.
        await RecipeService.AddRecipeAsync(recipe);

        // Return to the recipe list after successful creation.
        NavigationManager.NavigateTo("/recipes");
    }

    /// <summary>
    /// Applies the chosen recipe image.
    ///
    /// An uploaded image takes priority over the image URL. When no
    /// image is provided the recipe is saved without one.
    /// </summary>
    /// <returns>
    /// True when the image is valid and the recipe can be saved.
    /// </returns>
    private async Task<bool> ApplyRecipeImageAsync()
    {
        imageErrorMessage = null;

        // An uploaded image always wins over the image URL.
        if (selectedImage is not null)
        {
            var fileMessage =
                RecipeImageService.GetFileValidationMessage(selectedImage);

            if (fileMessage is not null)
            {
                imageErrorMessage = fileMessage;

                return false;
            }

            try
            {
                recipe.ImageUrl =
                    await RecipeImageService.SaveUploadedImageAsync(
                        Environment,
                        selectedImage);

                return true;
            }
            catch (Exception)
            {
                imageErrorMessage =
                    "The image could not be uploaded. Please try again.";

                return false;
            }
        }

        // Otherwise fall back to the image URL when one was entered.
        if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            if (!RecipeImageService.IsValidExternalImageUrl(imageUrl))
            {
                imageErrorMessage =
                    "Enter a valid image URL that starts with http:// or https://.";

                return false;
            }

            recipe.ImageUrl = imageUrl.Trim();

            return true;
        }

        // The image is optional, so the recipe is saved without one.
        recipe.ImageUrl = null;

        return true;
    }
}