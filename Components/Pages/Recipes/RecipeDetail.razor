@page "/recipes/{Id:int}"
@rendermode InteractiveServer
@using System.Security.Claims
@inject RecipeService RecipeService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

@if (Recipe is null)
{
    <p>Recipe not found.</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Recipe.ImageUrl))
    {
        <img class="recipe-image" src="@Recipe.ImageUrl" alt="@Recipe.Name" />
    }
    else
    {
        <div class="recipe-image-placeholder">No photo</div>
    }
    <h1 class="recipe-detail-name">@Recipe.Name</h1>
    <p class="recipe-detail-description">@Recipe.Description</p>
    <p class="recipe-detail-servings">Servings: @Recipe.Servings</p>
    <p class="recipe-detail-preptime">Prep. Time: @Recipe.PreparationTime minutes</p>
    <p class="recipe-detail-cooktime">Cook Time: @Recipe.CookingTime minutes</p>
    <p class="recipe-detail-ingredients">Ingredients: @Recipe.Ingredients</p>
    <p class="recipe-detail-instructions">Instructions: @Recipe.Instructions</p>

    <div class="mt-3">
        <a href="/recipes/edit/@Recipe.Id" class="btn btn-warning">Edit</a>
        <button class="btn btn-danger" @onclick="DeleteRecipe">Delete</button>
        <a href="/recipes" class="btn btn-secondary">Back to List</a>
        @if (isAuthenticated)
        {
            <button class="btn @(isFavorite ? "btn-outline-danger" : "btn-outline-secondary")" @onclick="ToggleFavorite">
                @(isFavorite ? "♥ Favorited" : "♡ Favorite")
            </button>
        }
    </div>
}

@code
{
    [Parameter]
    public int Id { get; set; }
    private Recipe? Recipe;
    private string? userId;
    private bool isAuthenticated;
    private bool isFavorite;

    protected override async Task OnParametersSetAsync()
    {
        Recipe = await RecipeService.GetRecipeByIdAsync(Id);

        AuthenticationState? authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal? user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                isFavorite = await RecipeService.IsFavoriteAsync(userId, Id);
            }
        }
    }

    private async Task DeleteRecipe()
    {
        if (Recipe != null)
        {
            await RecipeService.DeleteRecipeAsync(Recipe.Id);
            NavigationManager.NavigateTo("/recipes", forceLoad: true);
        }
    }

    private async Task ToggleFavorite()
    {
        if (string.IsNullOrEmpty(userId) || Recipe is null)
        {
            return;
        }

        isFavorite = await RecipeService.ToggleFavoriteAsync(userId, Recipe.Id);
    }
}
