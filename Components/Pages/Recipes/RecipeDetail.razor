@page "/recipes/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using ChefConnect.Models
@using ChefConnect.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject RecipeService RecipeService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<!--
===========================================================
ChefConnect - Recipe Details

Purpose:
Displays the complete information for a selected recipe.

Authenticated users can:
    • View recipes
    • Favorite/unfavorite recipes
    • Edit recipes they own
    • Delete recipes they own

The ownership check prevents users from editing or deleting
recipes belonging to another user.
===========================================================
-->

<PageTitle>
    @(Recipe?.Name ?? "Recipe") | ChefConnect
</PageTitle>

<div class="container py-4">

    @if (Recipe is null)
    {
        <!-- Displayed when the requested recipe does not exist. -->
        <div class="alert alert-warning" role="alert">

            <h1 class="h4">
                Recipe not found
            </h1>

            <p>
                The recipe you are looking for could not be found.
            </p>

            <a href="/recipes"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"
                   aria-hidden="true"></i>

                Back to Recipes

            </a>

        </div>
    }
    else
    {
        <article>

            <!--
            Recipe image.
            Externally hosted images and images uploaded to the
            application are both displayed here.
            -->
            @if (!string.IsNullOrWhiteSpace(imageSource))
            {
                <img class="recipe-image img-fluid rounded"
                     src="@imageSource"
                     alt="@Recipe.Name"
                     loading="lazy" />
            }
            else
            {
                <div class="recipe-image-placeholder"
                     role="img"
                     aria-label="No recipe photo available">

                    No photo

                </div>
            }

            <!-- Recipe title -->
            <h1 class="recipe-detail-name mt-4">
                @Recipe.Name
            </h1>

            <!-- Recipe description -->
            <p class="recipe-detail-description">
                @Recipe.Description
            </p>

            <!-- Basic recipe information -->
            <div class="row g-3 my-4">

                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h6">Servings</h2>
                            <p class="mb-0">
                                @Recipe.Servings
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h6">Preparation Time</h2>
                            <p class="mb-0">
                                @Recipe.PreparationTime minutes
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h6">Cooking Time</h2>
                            <p class="mb-0">
                                @Recipe.CookingTime minutes
                            </p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Ingredients -->
            <section class="mb-4">

                <h2 class="h4">
                    Ingredients
                </h2>

                <div class="card">
                    <div class="card-body">

                        <p class="mb-0">
                            @Recipe.Ingredients
                        </p>

                    </div>
                </div>

            </section>

            <!-- Instructions -->
            <section class="mb-4">

                <h2 class="h4">
                    Instructions
                </h2>

                <div class="card">
                    <div class="card-body">

                        <p class="mb-0">
                            @Recipe.Instructions
                        </p>

                    </div>
                </div>

            </section>

            <!-- Recipe actions -->
            <div class="mt-4 d-flex gap-2 flex-wrap">

                @if (isOwner)
                {
                    <!--
                    Only the owner of the recipe can edit or delete it.
                    -->

                    <a href="/recipes/edit/@Recipe.Id"
                       class="btn btn-warning">

                        <i class="bi bi-pencil me-1"
                           aria-hidden="true"></i>

                        Edit

                    </a>

                    @if (confirmDelete)
                    {
                        <!--
                        Second step of the delete process.
                        The recipe is not deleted until the user confirms.
                        -->

                        <button type="button"
                                class="btn btn-danger"
                                @onclick="DeleteRecipe">

                            <i class="bi bi-check-circle me-1"
                               aria-hidden="true"></i>

                            Yes, Delete

                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CancelDelete">

                            Cancel

                        </button>
                    }
                    else
                    {
                        <!-- Initial delete button -->
                        <button type="button"
                                class="btn btn-danger"
                                @onclick="RequestDelete">

                            <i class="bi bi-trash me-1"
                               aria-hidden="true"></i>

                            Delete

                        </button>
                    }
                }

                @if (isAuthenticated)
                {
                    <!--
                    Authenticated users can add or remove the recipe
                    from their favorites.
                    -->

                    <button type="button"
                            class="btn @(isFavorite
                                ? "btn-outline-danger"
                                : "btn-outline-secondary")"
                            @onclick="ToggleFavorite">

                        <i class="bi @(isFavorite
                            ? "bi-heart-fill"
                            : "bi-heart") me-1"
                           aria-hidden="true"></i>

                        @(isFavorite ? "Favorited" : "Favorite")

                    </button>
                }

                <a href="/recipes"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"
                       aria-hidden="true"></i>

                    Back to List

                </a>

            </div>

            @if (confirmDelete)
            {
                <!-- Delete warning -->
                <div class="alert alert-warning mt-3"
                     role="alert">

                    <strong>Are you sure?</strong>

                    This action will permanently delete
                    <strong>@Recipe.Name</strong>.

                </div>
            }

        </article>
    }

</div>

@code
{
    /// <summary>
    /// Recipe ID supplied through the URL.
    /// </summary>
    [Parameter]
    public int Id { get; set; }

    // Stores the recipe retrieved from the database.
    private Recipe? Recipe;

    // Image source resolved from the stored recipe image value.
    // This supports external URLs and uploaded images.
    private string? imageSource;

    // Stores the authenticated user's Identity ID.
    private string? userId;

    // Indicates whether a user is currently authenticated.
    private bool isAuthenticated;

    // Indicates whether the current user has favorited the recipe.
    private bool isFavorite;

    // Indicates whether the current user owns the recipe.
    private bool isOwner;

    // Controls the delete confirmation interface.
    private bool confirmDelete;

    /// <summary>
    /// Loads the requested recipe and determines the current
    /// user's authentication, favorite, and ownership status.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Retrieve the recipe from the database.
        Recipe = await RecipeService.GetRecipeByIdAsync(Id);

        // Resolve the image that should be displayed for the recipe.
        imageSource =
            RecipeImageService.ResolveImageSource(Recipe?.ImageUrl);

        // Retrieve the current authentication state.
        AuthenticationState authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        ClaimsPrincipal user = authState.User;

        // Determine whether the visitor is authenticated.
        isAuthenticated =
            user.Identity?.IsAuthenticated ?? false;

        // Reset state when navigating between recipes.
        isFavorite = false;
        isOwner = false;
        confirmDelete = false;
        userId = null;

        if (isAuthenticated)
        {
            // Retrieve the Identity user ID from the authentication claims.
            userId =
                user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrWhiteSpace(userId))
            {
                // Check whether the user has favorited this recipe.
                isFavorite =
                    await RecipeService.IsFavoriteAsync(userId, Id);

                // Check whether the authenticated user owns this recipe.
                if (Recipe != null)
                {
                    isOwner =
                        Recipe.UserId == userId;
                }
            }
        }
    }

    /// <summary>
    /// Displays the delete confirmation controls.
    /// </summary>
    private void RequestDelete()
    {
        confirmDelete = true;
    }

    /// <summary>
    /// Cancels the pending delete operation.
    /// </summary>
    private void CancelDelete()
    {
        confirmDelete = false;
    }

    /// <summary>
    /// Deletes the recipe after verifying ownership.
    /// </summary>
    private async Task DeleteRecipe()
    {
        // Ensure the recipe exists and the current user owns it.
        if (Recipe is null || !isOwner)
        {
            return;
        }

        await RecipeService.DeleteRecipeAsync(Recipe.Id);

        // Return to the recipe list after successful deletion.
        NavigationManager.NavigateTo("/recipes");
    }

    /// <summary>
    /// Adds or removes the current recipe from the user's favorites.
    /// </summary>
    private async Task ToggleFavorite()
    {
        // Favorites require an authenticated user and valid recipe.
        if (string.IsNullOrWhiteSpace(userId) || Recipe is null)
        {
            return;
        }

        // Update the favorite state through the service.
        isFavorite =
            await RecipeService.ToggleFavoriteAsync(
                userId,
                Recipe.Id);
    }
}