@page "/recipes"
@rendermode InteractiveServer
@using System.Security.Claims
@inject RecipeService RecipeService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<h3>My Recipes</h3>

<a href="/recipes/create" class="btn btn-primary mb-3">Create New Recipe</a>

@if (recipes == null)
{
    <p>Loading...</p>
}
else if (!recipes.Any())
{
    <p>No recipes found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Prep Time</th>
                <th>Cook Time</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recipe in recipes)
            {
                <tr>
                    <td>@recipe.Name</td>
                    <td>@(recipe.Category?.Name ?? "N/A")</td>
                    <td>@recipe.PreparationTime mins</td>
                    <td>@recipe.CookingTime mins</td>
                    <td>
                        <a href="/recipes/@recipe.Id" class="btn btn-info btn-sm">View</a>
                        <a href="/recipes/edit/@recipe.Id" class="btn btn-warning btn-sm">Edit</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteRecipe(recipe.Id)">Delete</button>
                        @if (isAuthenticated)
                        {
                            <button class="btn btn-sm @(favoriteIds.Contains(recipe.Id) ? "btn-outline-danger" : "btn-outline-secondary")" @onclick="() => ToggleFavorite(recipe.Id)">
                                @(favoriteIds.Contains(recipe.Id) ? "♥ Favorited" : "♡ Favorite")
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Recipe>? recipes;
    private string? userId;
    private bool isAuthenticated;
    private HashSet<int> favoriteIds = new HashSet<int>();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState? authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal? user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                recipes = await RecipeService.GetRecipesByUserAsync(userId);
                favoriteIds = await RecipeService.GetFavoriteRecipeIdsAsync(userId);
            }
        }
        else
        {
            recipes = new List<Recipe>();
        }
    }

    private async Task DeleteRecipe(int id)
    {
        await RecipeService.DeleteRecipeAsync(id);
        if (!string.IsNullOrEmpty(userId))
        {
            recipes = await RecipeService.GetRecipesByUserAsync(userId);
        }
    }

    private async Task ToggleFavorite(int recipeId)
    {
        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        bool nowFavorite = await RecipeService.ToggleFavoriteAsync(userId, recipeId);
        if (nowFavorite)
        {
            favoriteIds.Add(recipeId);
        }
        else
        {
            favoriteIds.Remove(recipeId);
        }
    }
}