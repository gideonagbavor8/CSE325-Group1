@page "/recipes"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject RecipeService RecipeService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<h3>My Recipes</h3>

<a href="/recipes/create" class="btn btn-primary mb-3">Create New Recipe</a>

@if (recipes == null)
{
    <p>Loading...</p>
}
else if (!recipes.Any())
{
    <p>No recipes found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Prep Time</th>
                <th>Cook Time</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recipe in recipes)
            {
                <tr>
                    <td>@recipe.Name</td>
                    <td>@(recipe.Category?.Name ?? "N/A")</td>
                    <td>@recipe.PreparationTime mins</td>
                    <td>@recipe.CookingTime mins</td>
                    <td>
                        <a href="/recipes/@recipe.Id" class="btn btn-info btn-sm">View</a>
                        <a href="/recipes/edit/@recipe.Id" class="btn btn-warning btn-sm">Edit</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteRecipe(recipe)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Recipe>? recipes;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await LoadUserRecipes();
    }

    private async Task LoadUserRecipes()
    {
        if (!string.IsNullOrEmpty(currentUserId))
        {
            recipes = await RecipeService.GetRecipesByUserIdAsync(currentUserId);
        }
        else
        {
            recipes = new List<Recipe>();
        }
    }

    private async Task DeleteRecipe(Recipe recipe)
    {
        if (!string.IsNullOrEmpty(currentUserId) && recipe.UserId == currentUserId)
        {
            await RecipeService.DeleteRecipeAsync(recipe.Id, currentUserId);
            await LoadUserRecipes();
        }
    }
}