@page "/recipes"
@rendermode InteractiveServer

@using System.Security.Claims
@using ChefConnect.Models
@using ChefConnect.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject RecipeService RecipeService
@inject AuthenticationStateProvider AuthStateProvider

<!--
===========================================================
ChefConnect - Recipe List

Purpose:
Displays all recipes available in ChefConnect and provides
options to view, edit, create, and delete recipes.

The delete operation uses a two-step confirmation process
to help prevent accidental deletion of recipes.
===========================================================
-->

<PageTitle>Recipes | ChefConnect</PageTitle>

<div class="container py-4">

    <!-- Page heading and create-recipe button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="page-intro mb-0">
            <h1>Recipes</h1>

            <p>
                Browse and manage recipes in ChefConnect.
            </p>
        </div>

        <a href="/recipes"
           class="btn btn-primary"
           @onclick="NavigateToCreateRecipe">

            <i class="bi bi-plus-circle me-1"
               aria-hidden="true"></i>

            Create Recipe
        </a>
    </div>

    @if (recipes == null)
    {
        <!-- Displayed while recipes are being retrieved. -->
        <div class="text-center py-5">

            <div class="spinner-border"
                 role="status"
                 aria-label="Loading recipes">
            </div>

            <p class="mt-2">
                Loading recipes...
            </p>

        </div>
    }
    else if (!recipes.Any())
    {
        <!-- Displayed when the database contains no recipes. -->
        <div class="alert alert-info"
             role="alert">

            No recipes have been added yet.

        </div>
    }
    else
    {
        <ul class="recipe-rows">

            @foreach (var recipe in recipes)
            {
                <li class="recipe-row">

                    <!-- Thumbnail, or a placeholder when there is no image -->
                    @if (RecipeImageService.ResolveImageSource(recipe.ImageUrl) is { } thumbnail)
                    {
                        <img class="recipe-row-thumb"
                             src="@thumbnail"
                             alt=""
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="recipe-row-thumb recipe-row-thumb-empty"
                             aria-hidden="true">

                            <i class="bi bi-image"></i>

                        </div>
                    }

                    <!-- Recipe summary -->
                    <div class="recipe-row-info">

                        <a class="recipe-row-name"
                           href="/recipes/@recipe.Id">

                            @recipe.Name

                        </a>

                        <div class="recipe-row-meta">

                            <span class="recipe-row-tag">
                                @(recipe.Category?.Name ?? "Uncategorized")
                            </span>

                            <span>
                                <i class="bi bi-clock me-1" aria-hidden="true"></i>
                                @(recipe.PreparationTime + recipe.CookingTime) mins total
                            </span>

                            <span>
                                <i class="bi bi-people me-1" aria-hidden="true"></i>
                                Serves @recipe.Servings
                            </span>

                        </div>

                    </div>

                    <!-- Recipe actions -->
                    <div class="recipe-row-actions">

                        <a href="/recipes/@recipe.Id"
                           class="btn btn-outline-secondary btn-sm">

                            <i class="bi bi-eye me-1"
                               aria-hidden="true"></i>

                            View
                        </a>

                        @if (IsOwnedByCurrentUser(recipe))
                        {
                            <!--
                            Editing and deleting are only offered on the
                            recipes belonging to the signed-in user. The
                            same rule is enforced again in RecipeService.
                            -->
                            <a href="/recipes/edit/@recipe.Id"
                               class="btn btn-outline-primary btn-sm">

                                <i class="bi bi-pencil me-1"
                                   aria-hidden="true"></i>

                                Edit
                            </a>

                            <!--
                            Selecting Delete only opens the confirmation
                            dialog. Nothing is removed until it is confirmed.
                            -->
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    @onclick="() => RequestDelete(recipe)"
                                    aria-label="Delete @recipe.Name">

                                <i class="bi bi-trash me-1"
                                   aria-hidden="true"></i>

                                Delete
                            </button>
                        }

                    </div>

                </li>
            }

        </ul>
    }

</div>

<!--
Confirmation of the last action. This floats above the page
and clears itself after a few seconds.
-->
<Toast Message="@statusMessage"
       OnClosed="ClearStatusMessage" />

<!-- Delete confirmation, shown over the page as a modal -->
<ConfirmDialog IsOpen="@(recipeToDelete is not null)"
               Title="Delete this recipe?"
               Message="@($"\"{recipeToDelete?.Name}\" will be permanently removed. This cannot be undone.")"
               ConfirmText="Yes, delete"
               OnConfirm="ConfirmDeleteRecipe"
               OnCancel="CancelDelete" />

@code
{
    // Stores the recipes retrieved from the database.
    private List<Recipe>? recipes;

    // The recipe awaiting deletion confirmation, if any.
    // While this is set, the confirmation dialog is displayed.
    private Recipe? recipeToDelete;

    // Provides feedback to the user after an operation.
    private string? statusMessage;

    // Identity ID of the signed-in user, or null when signed out.
    private string? userId;

    /// <summary>
    /// Loads recipes and the current user when the page opens.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadRecipesAsync();

        // The current user decides which recipes offer Edit and
        // Delete. Signed-out visitors can browse, and nothing more.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }
    }

    /// <summary>
    /// Determines whether the signed-in user created the recipe.
    /// </summary>
    private bool IsOwnedByCurrentUser(Recipe recipe)
    {
        return !string.IsNullOrWhiteSpace(userId)
            && recipe.UserId == userId;
    }

    /// <summary>
    /// Retrieves the latest recipe list from the database.
    /// </summary>
    private async Task LoadRecipesAsync()
    {
        recipes = await RecipeService.GetAllRecipesAsync();
    }

    /// <summary>
    /// Opens the confirmation dialog for the selected recipe.
    /// No deletion occurs at this stage.
    /// </summary>
    private void RequestDelete(Recipe recipe)
    {
        recipeToDelete = recipe;
        statusMessage = null;
    }

    /// <summary>
    /// Closes the dialog without deleting anything.
    /// </summary>
    private void CancelDelete()
    {
        recipeToDelete = null;
    }

    /// <summary>
    /// Deletes the selected recipe after the user confirms.
    /// </summary>
    private async Task ConfirmDeleteRecipe()
    {
        if (recipeToDelete is null)
        {
            return;
        }

        // The service refuses the deletion unless the current user
        // owns the recipe, so the result is checked here.
        var deleted = await RecipeService.DeleteRecipeAsync(
            recipeToDelete.Id,
            userId);

        // Close the dialog after the attempt.
        recipeToDelete = null;

        // Reload the recipes so the deleted recipe disappears immediately.
        await LoadRecipesAsync();

        statusMessage = deleted
            ? "The recipe was successfully deleted."
            : "You can only delete recipes that you created.";
    }

    /// <summary>
    /// Hides the confirmation message once the toast has run its
    /// course or the user dismisses it.
    /// </summary>
    private void ClearStatusMessage()
    {
        statusMessage = null;
    }

    /// <summary>
    /// Navigates the user to the recipe creation page.
    /// </summary>
    private void NavigateToCreateRecipe()
    {
        NavigationManager.NavigateTo("/recipes/create");
    }

    // NavigationManager is declared here so the page can navigate
    // to the recipe creation page without a standard HTML redirect.
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}