@page "/profile"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]

<PageTitle>My Profile | ChefConnect</PageTitle>

<!--
===========================================================
ChefConnect - User Profile

Purpose:
Provides authenticated users with a simple profile page.

The page displays information available from the authenticated
Identity claims without exposing sensitive account information.
===========================================================
-->

<div class="profile-page">

    <AuthorizeView>

        <Authorized>

            <!-- Account summary -->
            <div class="profile-header">

                <div class="profile-avatar profile-avatar-placeholder"
                     aria-hidden="true">

                    @GetInitial(context.User.Identity?.Name)

                </div>

                <div>

                    <h1>
                        My Profile
                    </h1>

                    <p class="profile-email">
                        @context.User.Identity?.Name
                    </p>

                    <p class="profile-since">
                        <span class="badge bg-success">
                            Signed in
                        </span>
                    </p>

                </div>

            </div>

            <!-- What you can do from here -->
            <div class="row g-3">

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h2 class="h5">
                                <i class="bi bi-journal-text me-1"
                                   aria-hidden="true"></i>

                                Browse recipes
                            </h2>

                            <p class="text-muted">
                                See every recipe on ChefConnect, and edit or
                                delete the ones you created.
                            </p>

                            <a href="/recipes"
                               class="btn btn-primary">

                                View Recipes

                            </a>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h2 class="h5">
                                <i class="bi bi-plus-circle me-1"
                                   aria-hidden="true"></i>

                                Add a recipe
                            </h2>

                            <p class="text-muted">
                                Share something you cook. You can add a photo
                                from your device or link to one online.
                            </p>

                            <a href="/recipes/create"
                               class="btn btn-outline-primary">

                                Create Recipe

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </Authorized>

        <NotAuthorized>

            <div class="alert alert-warning"
                 role="alert">

                <h1 class="h4">
                    Authentication Required
                </h1>

                <p>
                    Please log in to view your profile.
                </p>

                <a href="/Account/Login"
                   class="btn btn-primary">

                    Log In

                </a>

            </div>

        </NotAuthorized>

    </AuthorizeView>

</div>

@code
{
    /// <summary>
    /// First letter of the signed-in user's account name, used for
    /// the circular avatar.
    /// </summary>
    private static string GetInitial(string? accountName)
    {
        return string.IsNullOrWhiteSpace(accountName)
            ? "?"
            : accountName.Trim()[..1].ToUpperInvariant();
    }
}