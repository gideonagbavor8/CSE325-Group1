@page "/profile"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]

<PageTitle>My Profile | ChefConnect</PageTitle>

<!--
===========================================================
ChefConnect - User Profile

Purpose:
Provides authenticated users with a simple profile page.

The page displays information available from the authenticated
Identity claims without exposing sensitive account information.
===========================================================
-->

<div class="container py-5">

    <AuthorizeView>

        <Authorized>

            <div class="row justify-content-center">

                <div class="col-md-8 col-lg-6">

                    <div class="card shadow-sm">

                        <div class="card-body p-4">

                            <div class="text-center mb-4">

                                <i class="bi bi-person-circle display-4"
                                   aria-hidden="true"></i>

                                <h1 class="h3 mt-3">
                                    My Profile
                                </h1>

                                <p class="text-muted">
                                    Your ChefConnect account information.
                                </p>

                            </div>

                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    Account
                                </label>

                                <p class="form-control-plaintext">
                                    @context.User.Identity?.Name
                                </p>

                            </div>

                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    Account Status
                                </label>

                                <p class="form-control-plaintext">
                                    <span class="badge bg-success">
                                        Authenticated
                                    </span>
                                </p>

                            </div>

                            <hr />

                            <div class="d-flex gap-2 flex-wrap">

                                <a href="/recipes"
                                   class="btn btn-primary">

                                    <i class="bi bi-journal-text me-1"
                                       aria-hidden="true"></i>

                                    View Recipes

                                </a>

                                <a href="/recipes/create"
                                   class="btn btn-outline-primary">

                                    <i class="bi bi-plus-circle me-1"
                                       aria-hidden="true"></i>

                                    Create Recipe

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </Authorized>

        <NotAuthorized>

            <div class="alert alert-warning"
                 role="alert">

                <h1 class="h4">
                    Authentication Required
                </h1>

                <p>
                    Please log in to view your profile.
                </p>

                <a href="/Account/Login"
                   class="btn btn-primary">

                    Log In

                </a>

            </div>

        </NotAuthorized>

    </AuthorizeView>

</div>